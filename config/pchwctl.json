{
  "tickMs": 1000,
  "staleSensorS": 5,
  "sensors": {
    "mix": {
      "type": "mix",
      "fn": "max",
      "sources": [
        "sel:GpuAmd|Temperature|GPU Core",
        "/lpc/it8696e/temperature/4",
        "/lpc/it8696e/temperature/5",
        "/gpu-nvidia/0/temperature/0",
        "/intelcpu/0/temperature/1"
      ],
      "allowMissing": false
    }
  },
  "curves": {
    "graph": {
      "type": "graph",
      "source": "mix",
      "points": [
        [52.47, 20.06],
        [60.21, 38.72],
        [65, 80],
        [75, 90],
        [80, 100]
      ],
      "hysteresisUp": 2,
      "hysteresisDown": 2,
      "responseUpS": 2,
      "responseDownS": 2,
      "ignoreHysteresisAtLimits": true
    },
    "flat": {
      "type": "flat",
      "pct": 100
    },
    "auto": {
      "type": "auto",
      "source": "/intelcpu/0/temperature/22",
      "idleTemp": 45,
      "loadTemp": 75,
      "minPct": 50,
      "maxPct": 100,
      "step": 5,
      "deadband": 5,
      "responseS": 1
    },
    "gpu-amd": {
      "type": "graph",
      "source": "sel:GpuAmd|Temperature|GPU Core",
      "points": [
        [40, 30],
        [55, 65],
        [60, 80],
        [65, 90],
        [70, 100]
      ],
      "hysteresisUp": 2,
      "hysteresisDown": 2,
      "responseUpS": 2,
      "responseDownS": 2,
      "ignoreHysteresisAtLimits": true
    },
    "gpu-nvidia": {
      "type": "graph",
      "source": "/gpu-nvidia/0/temperature/0",
      "points": [
        [40, 30],
        [55, 65],
        [60, 80],
        [65, 90],
        [70, 100]
      ],
      "hysteresisUp": 2,
      "hysteresisDown": 2,
      "responseUpS": 2,
      "responseDownS": 2,
      "ignoreHysteresisAtLimits": true
    }
  },
  "fans": {
    "cpu-fans": {
      "control": "/lpc/it8696e/control/0",
      "tach": "/lpc/it8696e/fan/0",
      "curve": "auto",
      "enabled": true,
      "stepUp": 8,
      "stepDown": 8,
      "startPct": 0,
      "minPct": 0,
      "floorPct": 50,
      "offset": 0
    },
    "rear-fan": {
      "control": "/lpc/it8696e/control/1",
      "tach": "/lpc/it8696e/fan/1",
      "curve": "graph",
      "enabled": true,
      "stepUp": 8,
      "stepDown": 8,
      "startPct": 0,
      "minPct": 0,
      "floorPct": 0,
      "offset": 0
    },
    "front-fans": {
      "control": "/lpc/it8696e/control/2",
      "tach": "/lpc/it8696e/fan/2",
      "curve": "graph",
      "enabled": true,
      "stepUp": 8,
      "stepDown": 8,
      "startPct": 32,
      "minPct": 0,
      "floorPct": 0,
      "offset": 0
    },
    "water-pump": {
      "control": "/lpc/it8696e/control/4",
      "tach": "/lpc/it8696e/fan/4",
      "curve": "flat",
      "enabled": true,
      "stepUp": 8,
      "stepDown": 8,
      "startPct": 0,
      "minPct": 0,
      "floorPct": 100,
      "offset": 0
    },
    "gpu-amd": {
      "control": "/gpu-amd/0/control/0",
      "driver": "amd-od8",
      "tach": "/gpu-amd/0/fan/0",
      "curve": "gpu-amd",
      "zeroRpm": {
        "enabled": false,
        "stopBelowC": 50,
        "startAtC": 60,
        "park": "zero"
      }
    },
    "gpu-nvidia": {
      "control": "/gpu-nvidia/0/control/1",
      "tach": "/gpu-nvidia/0/fan/1",
      "curve": "gpu-nvidia",
      "zeroRpm": {
        "enabled": false,
        "stopBelowC": 50,
        "startAtC": 60,
        "park": "release"
      }
    }
  },
  "rgb": {
    "fps": 60,
    "deviceFps": { "it5711": 60, "ene-*": 20 },
    "brightness": 100,
    "groups": {
      "main": {
        "zones": [
          "it5711/*"
        ],
        "rule": {
          "type": "gradient",
          "source": "mix",
          "smoothingS": 2,
          "stops": [
            {
              "at": 62.4,
              "color": "#FFCBA1"
            },
            {
              "at": 63.2,
              "color": "#E6A839"
            },
            {
              "at": 64.5,
              "color": "#E6A839"
            },
            {
              "at": 68.9,
              "color": "#DC3737"
            }
          ]
        }
      },
      "ram": {
        "zones": [
          "ene-0x71/*",
          "ene-0x73/*"
        ],
        "rule": {
          "type": "gradient",
          "source": "mix",
          "smoothingS": 2,
          "stops": [
            {
              "at": 62.4,
              "color": "#FFFFFF"
            },
            {
              "at": 63.2,
              "color": "#E6D22E"
            },
            {
              "at": 64.5,
              "color": "#E6D22E"
            },
            {
              "at": 68.9,
              "color": "#DC456E"
            }
          ]
        }
      }
    }
  },
  "devices": {
    "it5711": {
      "enabled": true,
      "argb": {
        "ARGB_V2_1": {
          "header": 1,
          "leds": 24
        },
        "ARGB_V2_2": {
          "header": 2,
          "leds": 24
        },
        "ARGB_V2_3": {
          "header": 3,
          "leds": 24
        }
      },
      "single": {
        "12V": 4,
        "Accent": 2
      },
      "fallbackByteOrder": "GRB"
    },
    "ene": {
      "enabled": true,
      "addresses": [
        "0x71",
        "0x73"
      ],
      "expectedName": "AUDA0-E6K5-0101",
      "remap": true,
      "pawnIoLibPath": "C:\\Program Files\\PawnIO\\PawnIOLib.dll"
    }
  },
  "ipc": {
    "enabled": true,
    "pipeName": "PcHwCtl",
    "overrideTtlS": 60,
    "maxTtlS": 3600,
    "allowAccount": "NT AUTHORITY\\LocalService"
  },
  "displays": {
    "enabled": true,
    "pollS": 5,
    "models": {
      "DELL E1715S": {
        "power": "ddc-power",
        "powerOff": 4
      },
      "MSI PRO MP275": {
        "power": "ddc-input",
        "standbyInput": "0x01",
        "activeInput": "0x11"
      }
    }
  },
  "feed": {
    "enabled": true,
    "intervalMs": 500,
    "resolveS": 30,
    "requestsPollS": 5,
    "every": { "Cpu": 1000, "Memory": 1000 }
  },
  "power": {
    "nightPlan": "PcHwCtl Night",
    "dayPlan": "High performance"
  },
  "lasso": {
    "enabled": true,
    "ini": "C:\\ProgramData\\ProcessLasso\\config\\prolasso.ini",
    "profilesDir": "C:\\ProgramData\\PcHwCtl\\lasso",
    "ecoSweepS": 10
  }
